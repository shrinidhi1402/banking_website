# CRQ AI Knowledge Layer — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env — it is gitignored.

# Direct Postgres connection string to Supabase
# URL-encode any special characters in the password (e.g. [ → %5B, @ → %40, ] → %5D)
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# FastAPI server port (default: 8100)
AI_KNOWLEDGE_PORT=8100
