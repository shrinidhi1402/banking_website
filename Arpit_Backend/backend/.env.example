# ============================================================
# CRQ Backend — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# ============================================================

# App
CRQ_DEBUG=false
CRQ_LOG_LEVEL=INFO
CRQ_LOG_FORMAT=json

# Database (app connects as crq_app non-superuser — architecture ss10.2)
CRQ_DATABASE_URL=postgresql+asyncpg://crq_app:crq_app_password@pgbouncer:5432/crq
CRQ_DATABASE_URL_DIRECT=postgresql+asyncpg://crq_app:crq_app_password@postgres:5432/crq

# Redis
CRQ_REDIS_URL=redis://redis:6379/0

# MinIO
CRQ_MINIO_ENDPOINT=minio:9000
CRQ_MINIO_ACCESS_KEY=minioadmin
CRQ_MINIO_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
CRQ_MINIO_SECURE=false
CRQ_MINIO_DEFAULT_BUCKET=crq-data

# Redpanda / Kafka
CRQ_KAFKA_BOOTSTRAP_SERVERS=redpanda:19092

# Auth — DISABLE_AUTH=true means teammates never blocked by Keycloak.
# Set to false only when Keycloak is fully configured.
CRQ_DISABLE_AUTH=true
CRQ_KEYCLOAK_URL=http://keycloak:8080
CRQ_KEYCLOAK_REALM=crq
CRQ_KEYCLOAK_CLIENT_ID=crq-api
CRQ_KEYCLOAK_CLIENT_SECRET=CHANGE_ME_IN_PRODUCTION

# Observability
CRQ_OTEL_ENABLED=true
CRQ_OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
CRQ_OTEL_SERVICE_NAME=crq-api
CRQ_GLITCHTIP_DSN=http://key@glitchtip:8000/1

# Celery
CRQ_CELERY_BROKER_URL=redis://redis:6379/1
CRQ_CELERY_RESULT_BACKEND=redis://redis:6379/2

# AI Gateway (B4 — not needed until Phase 4)
CRQ_VLLM_BASE_URL=http://vllm:8000/v1
CRQ_TEI_BASE_URL=http://tei:8001
CRQ_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
CRQ_EMBEDDING_MODEL=BAAI/bge-m3
