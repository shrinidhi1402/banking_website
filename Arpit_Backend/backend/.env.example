# ============================================================
# CRQ Backend — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# ============================================================

# App
CRQ_DEBUG=false
CRQ_LOG_LEVEL=INFO
CRQ_LOG_FORMAT=json

# Database (app connects via Supabase Transaction Pooler)
CRQ_SUPABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
CRQ_SUPABASE_SERVICE_KEY=CHANGE_ME_IN_PRODUCTION

# Redis
CRQ_REDIS_URL=redis://redis:6379/0

# Auth — DISABLE_AUTH=true means teammates never blocked by auth setup
CRQ_DISABLE_AUTH=true
CRQ_SUPABASE_JWT_SECRET=CHANGE_ME_IN_PRODUCTION

# Observability
CRQ_OTEL_ENABLED=true
CRQ_OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
CRQ_OTEL_SERVICE_NAME=crq-api
CRQ_GLITCHTIP_DSN=http://key@glitchtip:8000/1

# Celery
CRQ_CELERY_BROKER_URL=redis://redis:6379/1
CRQ_CELERY_RESULT_BACKEND=redis://redis:6379/2

# AI Gateway (B4 — not needed until Phase 4)
CRQ_VLLM_BASE_URL=http://vllm:8000/v1
CRQ_TEI_BASE_URL=http://tei:8001
CRQ_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
CRQ_EMBEDDING_MODEL=BAAI/bge-m3
